# Terraform state — NEVER commit state files
**/*.tfstate
**/*.tfstate.*
**/.terraform/
**/.terraform.lock.hcl

# Terraform plan output
*.tfplan
*.tfplan.json
tfplan

# Sensitive variable files
*.tfvars
*.tfvars.json
!backend.tfvars
!example.tfvars

# Crash logs
crash.log
crash.*.log

# Override files (local developer overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI config
.terraformrc
terraform.rc

# Local kubeconfig / cluster scratch
kubeconfig
kubeconfig-*
*.kubeconfig

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/

# Local working notes — not part of the repo
HANDOFF.md
